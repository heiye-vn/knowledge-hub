# 服务端口
PORT=3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=123456
POSTGRES_DB=knowledge_hub

# MongoDB
MONGO_URI=mongodb://mongo_user:mongo_pass123@localhost:27017/knowledge_hub?authSource=admin

# Snowflake (snowflake-id: mid 0–1023)
SNOWFLAKE_WORKER_ID=1
# Epoch offset ms; default ≈ 2024-01-01
SNOWFLAKE_OFFSET=1704067200000

# Elasticsearch (向量 + 中文全文检索)
# 关闭时跳过向量写入与检索，应用仍可正常启动（降级不阻断）
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=kh_chunk

# Embedding（阿里云百炼 text-embedding-v3，OpenAI 兼容协议）
# 未配置 Key 时不阻断启动，首次使用时报明确业务异常
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认 qwen3.7-text-embedding-flash：1024 维（默认，可选 768/512/256）、128K 上下文
# ⚠️ 换模型后必须全量重索引 —— 不同模型向量空间不兼容，即使维度相同
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# 必须与 kh_chunk mapping 的 embedding.dims 一致；变更需删索引重建 + 全量重索引
EMBEDDING_DIMENSION=1024
# 实际每批条数（受下面的上限钳制）
EMBEDDING_BATCH_SIZE=20
# 模型单次请求条数上限：qwen3.7 系列=20；text-embedding-v3/v4=10
EMBEDDING_MAX_BATCH_SIZE=20

# RAG 分块 / 检索
# 单位：token（代码内 ×2 换算为字符，即 512 token ≈ 1024 字符），与参考项目语义一致
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5
RAG_KNN_K=50
RAG_KNN_CANDIDATES=200
RAG_RRF_WINDOW=100
RAG_RRF_CONSTANT=60
# Redis / BullMQ（阶段二：文档批量重建索引队列）
# 关闭时应用正常启动，仅批量重建不可用（publish 仍同步执行，不受影响）
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
# Worker 并发数（默认 1：embedding 走远程 API，并发高易触发限流，且重建是后台任务不追求快）
RAG_REINDEX_CONCURRENCY=1
# 单任务最大尝试次数（含首次）+ 指数退避基数 ms
# 🔴 修参考项目缺陷：其消费失败 nack(requeue=false)，无重试，一次超时该文档索引永久丢失
RAG_REINDEX_ATTEMPTS=3
RAG_REINDEX_BACKOFF_MS=5000

# 向量召回最低余弦相似度（0~1），低于此值视为不相关并丢弃
# kNN 必然返回 topK 条，没有门槛会把无关内容喂给 LLM 造成噪声甚至幻觉
#
# 0.72 由实测校准（qwen3.7-text-embedding-flash）：相关查询 0.7478~0.8050，
# 不相关查询 0.6519~0.7081，分界取两者之间。
# ⚠️ 换 embedding 模型或语料后必须重新校准，本值只对当前模型+语料有效
RAG_MIN_SCORE=0.72

# LLM（KG 实体关系抽取，OpenAI 兼容协议）
# 🔴 未配置 LLM_API_KEY 时自动回退 EMBEDDING_API_KEY（百炼 chat 与 embedding 共用 Key），
#    三者都没有时抽取不可用但不阻断启动
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# 单次抽取超时（毫秒）。实测 qwen-plus 单块 19~57s，60s 是合理下限
KG_LLM_TIMEOUT_MS=60000
# 实测 qwen-plus 单块产出 24~40 个实体 / 20+ 条关系，上限设小会大量截断
KG_MAX_ENTITIES=30
KG_MAX_RELATIONS=30
# 批量抽取的块内并发（远程 LLM，并发高了易限流）
KG_EXTRACT_CONCURRENCY=3
# 单篇建图最多处理的块数（按序截断）。30 块 × 实测 19~57s/块 ≈ 10~30 分钟，防单篇跑小时级
KG_MAX_CHUNKS=30

# Neo4j（KG 图谱存储，docker-compose 里的 neo4j 服务）
# 关闭时应用正常启动，仅图谱不可用
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678

# KG 建图队列（BullMQ 第二队列，与 rag.reindex 并列）
# 单块抽取 19~57s → KG 必须异步；publish 只负责入队，响应里 kgQueued 表示是否排队成功
KG_BUILD_CONCURRENCY=1
KG_BUILD_ATTEMPTS=3
# 退避基数毫秒：抽取耗时长，失败后等 30s 再重试（指数增长 30s→60s→120s）
KG_BUILD_BACKOFF_MS=30000
