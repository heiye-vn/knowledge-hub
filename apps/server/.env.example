# 服务端口
PORT=3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=123456
POSTGRES_DB=knowledge_hub

# MongoDB
MONGO_URI=mongodb://mongo_user:mongo_pass123@localhost:27017/knowledge_hub?authSource=admin

# Snowflake (snowflake-id: mid 0–1023)
SNOWFLAKE_WORKER_ID=1
# Epoch offset ms; default ≈ 2024-01-01
SNOWFLAKE_OFFSET=1704067200000

# Elasticsearch (向量 + 中文全文检索)
# 关闭时跳过向量写入与检索，应用仍可正常启动（降级不阻断）
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=kh_chunk

# Embedding（阿里云百炼 text-embedding-v3，OpenAI 兼容协议）
# 未配置 Key 时不阻断启动，首次使用时报明确业务异常
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
# 必须与 kh_chunk mapping 的 embedding.dims 一致；变更需删索引重建 + 全量重索引
EMBEDDING_DIMENSION=1024
# 百炼单次上限 10，代码内再钳制
EMBEDDING_BATCH_SIZE=10

# RAG 分块 / 检索
# 单位：token（代码内 ×2 换算为字符，即 512 token ≈ 1024 字符），与参考项目语义一致
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5
RAG_KNN_K=50
RAG_KNN_CANDIDATES=200
RAG_RRF_WINDOW=100
RAG_RRF_CONSTANT=60
