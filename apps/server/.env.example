# 服务端口
PORT=3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=123456
POSTGRES_DB=knowledge_hub

# MongoDB
MONGO_URI=mongodb://mongo_user:mongo_pass123@localhost:27017/knowledge_hub?authSource=admin

# Snowflake (snowflake-id: mid 0–1023)
SNOWFLAKE_WORKER_ID=1
# Epoch offset ms; default ≈ 2024-01-01
SNOWFLAKE_OFFSET=1704067200000
