# ===================================================================
# Knowledge Hub 环境变量示例模板 (.env.example)
# 使用说明：复制一份并重命名为 .env，按需调整配置
# ===================================================================

# -------------------------------------------------------------------
# 1. 基础服务与容器配置
# -------------------------------------------------------------------
PORT=3000

# Docker 数据卷本地挂载路径（供 docker-compose.yml 使用，默认当前目录 ./volumes）
DOCKER_VOLUME_DIRECTORY=.

# -------------------------------------------------------------------
# 2. 数据库配置 (PostgreSQL - 元数据与正文存储)
# -------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=123456
POSTGRES_DB=knowledge_hub

# -------------------------------------------------------------------
# 3. 分布式主键雪花 ID (Snowflake)
# -------------------------------------------------------------------
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_OFFSET=1704067200000

# -------------------------------------------------------------------
# 4. 用户鉴权与安全 (JWT 双令牌)
# -------------------------------------------------------------------
# ⚠️ 生产环境必须更换为强随机密钥！access 与 refresh 独立密钥
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
# 有效期（支持 s/m/h/d 单位）
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

# -------------------------------------------------------------------
# 5. 搜索引擎 (Elasticsearch - 向量与全文检索)
# -------------------------------------------------------------------
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=kh_chunk

# -------------------------------------------------------------------
# 6. 缓存与异步任务队列 (Redis + BullMQ)
# -------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
RAG_REINDEX_CONCURRENCY=1
RAG_REINDEX_ATTEMPTS=3
RAG_REINDEX_BACKOFF_MS=5000

# -------------------------------------------------------------------
# 7. 向量嵌入模型 (Embedding - 阿里云百炼 / OpenAI 兼容)
# -------------------------------------------------------------------
# 🔴【核心必填】向量模型 API Key（未配置时不阻断启动，但发布文档/检索时会报错）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=20
EMBEDDING_MAX_BATCH_SIZE=20

# -------------------------------------------------------------------
# 8. RAG 知识检索与切片配置
# -------------------------------------------------------------------
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5
RAG_KNN_K=50
RAG_KNN_CANDIDATES=200
RAG_RRF_WINDOW=100
RAG_RRF_CONSTANT=60
RAG_MIN_SCORE=0.72

# -------------------------------------------------------------------
# 9. 知识图谱大模型 (KG LLM - 实体关系抽取)
# -------------------------------------------------------------------
# 🔴【可选必填】抽取大模型 API Key（未填时自动回退 EMBEDDING_API_KEY）
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
KG_LLM_TIMEOUT_MS=60000
KG_MAX_ENTITIES=30
KG_MAX_RELATIONS=30
KG_EXTRACT_CONCURRENCY=3
KG_MAX_CHUNKS=30

# -------------------------------------------------------------------
# 10. 图数据库 (Neo4j - 知识图谱存储)
# -------------------------------------------------------------------
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
KG_BUILD_CONCURRENCY=1
KG_BUILD_ATTEMPTS=3
KG_BUILD_BACKOFF_MS=30000

# -------------------------------------------------------------------
# 11. 视觉大模型 (VLM - 图片类文档解析：png/jpg/jpeg/webp)
# -------------------------------------------------------------------
# 🔴【可选】严格物理隔离：若需解析图片，必须配置独立的 API Key，不自动复用 LLM Key
VLM_API_KEY=
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3.8-flash
VLM_TIMEOUT_MS=60000

# -------------------------------------------------------------------
# 12. 对象存储 (Storage - 文档原件与图片存储)
# -------------------------------------------------------------------
STORAGE_DRIVER=rustfs

# --- 模式一：RustFS（本地离线推荐，与 docker-compose 内 rustfs 服务配合） ---
RUSTFS_ENABLED=true
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=knowledge-hub
RUSTFS_PUBLIC_URL=http://localhost:9000

# --- 模式二：阿里云 OSS（若 STORAGE_DRIVER=oss 则需填写以下项） ---
OSS_ENABLED=false
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_CUSTOM_DOMAIN=
OSS_ENDPOINT=

# -------------------------------------------------------------------
# 13. 业务流转配置
# -------------------------------------------------------------------
DOCUMENT_REQUIRE_APPROVAL=false
